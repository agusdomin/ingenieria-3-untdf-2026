# Contraseña de PostgreSQL, compartida con el backend
DB_PASSWORD=reemplazar_por_una_password_segura

# Clave secreta de Django: usar un valor largo, aleatorio y privado
SECRET_KEY=reemplazar_por_una_clave_larga_y_aleatoria

# Hosts permitidos, separados por comas, sin protocolo ni puerto
ALLOWED_HOSTS=api.ejemplo.com,localhost,127.0.0.1

# Límites de frecuencia (rate limiting) opcionales
# THROTTLE_ANON_RATE=100/minute
# THROTTLE_USER_RATE=1000/minute
# THROTTLE_AUTH_RATE=10/minute
